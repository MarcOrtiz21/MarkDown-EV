{
  "name": "markdown-ev",
  "private": true,
  "version": "0.1.0",
  "description": "Visor-editor de Markdown minimalista para macOS",
  "author": "Marc",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:fresh": "npm run dev:stop && rm -rf node_modules/.vite && vite",
    "dev:stop": "lsof -ti:5173 2>/dev/null | xargs kill -9 2>/dev/null || true; pkill -f 'Electron.*MarkDown EV' 2>/dev/null || true; pkill -f 'Electron.*markdown-ev' 2>/dev/null || true",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder",
    "postinstall": "mkdir -p public/katex && cp -R node_modules/katex/dist/. public/katex/",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.1",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.15",
    "@mdit/plugin-katex": "^1.0.1",
    "@replit/codemirror-vim": "^6.3.0",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.markdown-ev.app",
    "productName": "MarkDown EV",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "fileAssociations": [
        {
          "ext": ["md", "markdown", "mdown", "mkd"],
          "name": "Markdown Document",
          "role": "Editor"
        }
      ]
    }
  }
}
